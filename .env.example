# Copy to .env.local and fill in. Never commit real keys.
# Checkout stays disabled (with a friendly message) until both Stripe keys are set.

# Stripe secret key (server only). Use sk_test_... while testing.
STRIPE_SECRET_KEY=

# Stripe publishable key. Use pk_test_... while testing.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public URL of the site, used for canonical URLs, sitemap, and Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
